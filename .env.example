# ==========================================================
# IA GENERATIVA — OpenAI (o cualquier proveedor compatible
# con el protocolo OpenAI: OpenAI, Azure, Groq, Ollama, etc.)
# ==========================================================
# Si dejas OPENAI_API_KEY vacío, la app corre en modo offline
# con un generador determinista (sin consumo de API).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ==========================================================
# BACKEND
# ==========================================================
HOST=0.0.0.0
PORT=8000

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173