# ==========================================================
# IA GENERATIVA — OpenAI (o cualquier proveedor compatible
# con el protocolo OpenAI: OpenAI, Azure, Groq, Ollama, etc.)
# ==========================================================
# Se usa con LLM_PROVIDER=openai. Si dejas OPENAI_API_KEY vacío,
# la app corre en modo offline (sin consumo de API).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Proveedor del modelo de lenguaje: offline | openai | anthropic.
# - offline (por defecto): determinista, sin red ni clave.
# - openai / anthropic: usa el adaptador real SOLO si su clave está definida;
#   si la clave falta, la app avisa en el log y sigue en modo offline.
LLM_PROVIDER=offline

# ==========================================================
# IA GENERATIVA — Anthropic (Claude)
# ==========================================================
# ANTHROPIC_MODEL atiende interpretación y aclaración;
# ANTHROPIC_EXPLAIN_MODEL atiende la explicación de resultados.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_EXPLAIN_MODEL=claude-sonnet-5-5

# ==========================================================
# BACKEND
# ==========================================================
HOST=0.0.0.0
PORT=8000

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173