# ==========================================================
# IA GENERATIVA — cualquier proveedor compatible con el
# protocolo OpenAI: Groq, OpenAI, Azure, Ollama, etc.
# ==========================================================
# Si dejas OPENAI_API_KEY vacío, la app corre en modo offline
# con un parser léxico y un explicador determinista (sin API).
#
# ---- OPCIÓN RECOMENDADA (gratuita): Groq ----------------
# 1. Crea una cuenta en https://console.groq.com (email o
#    Google/GitHub; NO pide tarjeta).
# 2. Ve a "API Keys" -> "Create API Key" y copia la clave
#    (se muestra una sola vez; empieza con "gsk_...").
# 3. Pégala en OPENAI_API_KEY de tu archivo .env.
# Capa gratuita: ~30 req/min y ~14,400 req/día (suficiente).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Modelos vigentes en la capa gratuita de Groq (verificados oct-2026 con
# GET https://api.groq.com/openai/v1/models):
OPENAI_MODEL=openai/gpt-oss-120b
# Alternativas: openai/gpt-oss-20b (más rápido) | qwen/qwen3.8-27b
#
# ---- Otras opciones --------------------------------------
# OpenAI:  OPENAI_BASE_URL=https://api.openai.com/v1
#          OPENAI_MODEL=gpt-4o-mini
# Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1
#          OPENAI_MODEL=llama3.1   (OPENAI_API_KEY=ollama)

# ==========================================================
# BACKEND
# ==========================================================
HOST=0.0.0.0
PORT=8000

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
